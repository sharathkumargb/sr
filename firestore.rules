rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == "REPLACE_WITH_OWNER_UID";
    }
    match /registrations/{registrationId} {
      // Public visitors may submit only the allowed fields.
      allow create: if request.resource.data.keys().hasOnly(
        ['name', 'email', 'college', 'year', 'createdAt']
      )
      && request.resource.data.name is string
      && request.resource.data.email is string
      && request.resource.data.name.size() > 0
      && request.resource.data.email.size() > 0;
      // Only the authenticated site owner may read, edit or delete registrations.
      allow read, update, delete: if isOwner();
    }
  }
}
